// ECE6370
// Author: Dharani Kandhalam - 1389
// Name of Module: testbench_msecTimer_LFSR_findTerminal
// Description: This testbench simulates the regular 1 ms timer and the
// LFSR-based timer side by side using the same clock, reset, and enable.
// It is used to identify the LFSR state present when the regular timer
// generates its timeout pulse.
// Comments/Log: First run for terminal-value discovery.

module testbench_msecTimer_LFSR_findTerminal;

reg clk, rst, enable;
wire timeout_old1ms;
wire [15:0] lfsr_q;

msecTimer DUT_old1ms(enable, clk, rst, timeout_old1ms);

msecTimer_LFSR_findTerminal DUT_lfsr1ms(enable, clk, rst, lfsr_q);

always begin
    clk = 1'b0; #10;
    clk = 1'b1; #10;
end

integer pulse_count;

initial begin
    rst = 1'b0;
    enable = 1'b0;
    pulse_count = 0;

    #25;
    rst = 1'b1;
    enable = 1'b1;

    #2500000;
    $stop;
end

always @(posedge clk) begin
    if (timeout_old1ms == 1'b1) begin
        pulse_count = pulse_count + 1;
        $display("Regular 1ms pulse %0d at time=%0t, LFSR state = %h",
                 pulse_count, $time, lfsr_q);

        if (pulse_count == 2)
            $stop;
    end
end

endmodule